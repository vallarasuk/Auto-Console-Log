{
  "name": "auto-console-log-by-vallarasu-kanthasamy",
  "displayName": "Auto Console Log By Vallarasu Kanthasamy",
  "description": "Effortlessly insert console.log statements for all declared variables in JavaScript, TypeScript, and React files. Built for fast debugging and productivity by React Developer Vallarasu Kanthasamy.",
  "version": "0.4.0",
  "publisher": "VallarasuKanthasamy",
  "icon": "logo.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "console.log",
    "logger",
    "debugger",
    "debug",
    "log automation",
    "javascript",
    "typescript",
    "react",
    "vscode",
    "vs code extension",
    "developer tools",
    "debug tools",
    "vallarasu",
    "vallarasu kanthasamy",
    "react developer",
    "console injection",
    "auto log",
    "productivity",
    "logging utility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vallarasuk/Auto-Console-Log.git"
  },
  "bugs": {
    "url": "https://github.com/vallarasuk/Auto-Console-Log/issues"
  },
  "homepage": "https://github.com/vallarasuk/Auto-Console-Log#readme",
  "activationEvents": [
    "onCommand:extension.addConsoleLogs",
    "onCommand:extension.addConsoleLogForSelection",
    "onCommand:extension.removeConsoleLogs"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extension.addConsoleLogs",
        "title": "Add Console Logs",
        "category": "Auto Console Log"
      },
      {
        "command": "extension.addConsoleLogForSelection",
        "title": "Add Console Log for Selection",
        "category": "Auto Console Log"
      },
      {
        "command": "extension.removeConsoleLogs",
        "title": "Remove All Console Logs",
        "category": "Auto Console Log"
      }
    ],
    "keybindings": [
      {
        "command": "extension.addConsoleLogs",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.addConsoleLogForSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.removeConsoleLogs",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Auto Console Log By Vallarasu Kanthasamy",
      "properties": {
        "autoConsoleLogByVallarasuKanthasamy.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable the extension."
        },
        "autoConsoleLogByVallarasuKanthasamy.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "log",
            "info",
            "warn",
            "error"
          ],
          "description": "Set the log level for generated console statements."
        },
        "autoConsoleLogByVallarasuKanthasamy.pro.logTemplate": {
          "type": "string",
          "default": "",
          "description": "Custom log template for Pro users. Use {varName}, {line}, {file}, {context} as placeholders."
        },
        "autoConsoleLogByVallarasuKanthasamy.pro.remoteLogUrl": {
          "type": "string",
          "default": "",
          "description": "URL to send logs to for remote debugging (Pro feature)."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.25.1"
  },
  "dependencies": {
    "@babel/parser": "^7.23.10",
    "@babel/traverse": "^7.24.0",
    "@babel/types": "^7.24.0"
  },
  "files": [
    "dist",
    "media",
    "README.md",
    "Assets"
  ]
}
